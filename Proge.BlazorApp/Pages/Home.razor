@page "/"
@inject IApiClient ApiClient
@using Proge.BlazorApp

<PageTitle>Budgets</PageTitle>

<h1>Budgets</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (budgets == null)
{
    <p>Laen...</p>
}
else
{
    <p><a class="btn btn-primary" href="/create">Add new</a></p>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>Date</th>
                <th>Service Cost</th>
                <th>Total Cost</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var budget in budgets)
            {
                <tr>
                    <td>@budget.Id</td>
                    <td>@budget.Client</td>
                    <td>@budget.Date.ToShortDateString()</td>
                    <td>@budget.ServiceCost</td>
                    <td>@budget.TotalCost</td>
                    <td>
                        <a href="/edit/@budget.Id" class="btn btn-primary">Edit</a>
                        <button class="btn btn-danger" @onclick="() => Delete(budget.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Budget>? budgets;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var result = await ApiClient.List();
        if (result.HasError)
            errorMessage = string.Join(", ", result.Errors.SelectMany(e => e.Value));
        else
            budgets = result.Value;
    }

    private async Task Delete(int id)
    {
        await ApiClient.Delete(id);
        await Load();
    }
}