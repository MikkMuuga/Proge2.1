@model Proge2._1.Models.ServiceIndexModel

@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<form method="get" class="mb-3">
    <div class="form-group">
        <label class="control-label">Transport</label>
        <input asp-for="Search.Transportation" class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">How many</label>
        <input asp-for="Search.PanelProduction" type="number" step="0.01" class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">Type of montage</label>
        <input asp-for="Search.Montage" type="date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                transportation
            </th>
            <th>
                PanelProduction
            </th>
            <th>
                montage
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Data.Items) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.transportation)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PanelProduction)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.montage)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ServiceId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ServiceId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ServiceId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
